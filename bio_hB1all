// 每次遊戲隨機抽幾題，只要改這個數字即可
const QUESTIONS_PER_GAME = 7;

const typeNames = {
  2: '自動選擇',
  3: '選擇題',
  4: '填空題',
  9: '是非題'
};

let currentQuestion = 0;
let correctCount = 0; // 第一次就答對的題數
let startTime = Date.now();
let timerInterval = null;
let selectedAnswer = null;
let answered = false;
let shuffledQuestions = [];
let reviewLog = [];

function shuffle(arr) {
  return [...arr].sort(() => Math.random() - 0.5);
}

function initGame() {
  const questionCount = Math.min(Math.max(1, QUESTIONS_PER_GAME), allQuestions.length);
  shuffledQuestions = shuffle(allQuestions).slice(0, questionCount);
  reviewLog = shuffledQuestions.map(q => ({
    question: q.question,
    type: q.type,
    correctAnswer: displayAnswer(q.answer),
    wrongAttempts: [],
    gotCorrect: false,
    explanation: q.explanation
  }));
  showQuestion();
  startTimer();

  document.addEventListener('keypress', (e) => {
    if (e.key === 'Enter') {
      if (answered) nextQuestion();
      else submitAnswer();
    }
  });
}

function displayAnswer(value) {
  if (value === true) return 'O';
  if (value === false) return 'X';
  return String(value);
}

function showQuestion() {
  answered = false;
  selectedAnswer = null;
  const q = shuffledQuestions[currentQuestion];

  document.getElementById('progress').textContent =
    (currentQuestion + 1) + '/' + shuffledQuestions.length;
  document.getElementById('questionProgress').textContent =
    '第 ' + (currentQuestion + 1) + ' 題 / 共 ' + shuffledQuestions.length + ' 題';
  document.getElementById('questionType').textContent = typeNames[q.type];
  document.getElementById('questionText').textContent = q.question;

  const feedback = document.getElementById('feedback');
  feedback.className = 'feedback';
  feedback.innerHTML = '';

  const contentArea = document.getElementById('contentArea');
  contentArea.innerHTML = '';

  if (q.type === 2) renderAutoSelect(q, contentArea);
  else if (q.type === 3) renderSelect(q, contentArea);
  else if (q.type === 4) renderText(q, contentArea);
  else if (q.type === 9) renderTrueFalse(q, contentArea);

  const submitBtn = document.getElementById('submitBtn');
  submitBtn.textContent = '確認答案';
  submitBtn.onclick = submitAnswer;
}

function renderAutoSelect(q, container) {
  generateOptions(q.answer).forEach(opt => makeOptionButton(container, opt, opt));
}

function renderSelect(q, container) {
  if (!q.options) return;
  shuffle(q.options).forEach(opt => makeOptionButton(container, opt, opt));
}

function makeOptionButton(container, label, value) {
  const btn = document.createElement('button');
  btn.className = 'option-btn';
  btn.textContent = label;
  btn.onclick = () => selectOption(btn, value);
  container.appendChild(btn);
}

function renderText(q, container) {
  const input = document.createElement('input');
  input.type = 'text';
  input.className = 'input-field';
  input.placeholder = '輸入答案';
  input.addEventListener('input', () => selectedAnswer = input.value.trim());
  container.appendChild(input);
  input.focus();
}

function renderTrueFalse(q, container) {
  makeOptionButton(container, 'O', true);
  makeOptionButton(container, 'X', false);
}

function selectOption(btn, value) {
  if (answered || btn.disabled) return;
  document.querySelectorAll('.option-btn[data-selected="true"]').forEach(b => {
    b.removeAttribute('data-selected');
  });
  btn.setAttribute('data-selected', 'true');
  selectedAnswer = value;
}

function generateOptions(answer) {
  if (!isNaN(answer) && String(answer).trim() !== '') {
    const num = Number(answer);
    return shuffle([
      String(answer),
      String(num + 1),
      String(num - 1),
      String(num + 2)
    ]);
  }
  return shuffle([String(answer), '以上皆是', '以上皆非', '不一定']);
}

function normalize(v) {
  return String(v).trim().toLowerCase();
}

function isAnswerCorrect(q, value) {
  if (q.type === 9) return value === q.answer;
  return normalize(value) === normalize(q.answer);
}

function submitAnswer() {
  if (answered) {
    nextQuestion();
    return;
  }

  const q = shuffledQuestions[currentQuestion];
  const log = reviewLog[currentQuestion];
  const feedback = document.getElementById('feedback');

  if (selectedAnswer === null || selectedAnswer === '') {
    feedback.className = 'feedback show error';
    feedback.textContent = '請先作答';
    return;
  }

  if (isAnswerCorrect(q, selectedAnswer)) {
    answered = true;
    log.gotCorrect = true;

    if (log.wrongAttempts.length === 0) {
      correctCount++;
      document.getElementById('correct').textContent = correctCount;
    }

    document.querySelectorAll('.option-btn').forEach(btn => {
      btn.disabled = true;
      const selected = btn.getAttribute('data-selected') === 'true';
      if (selected) {
        btn.style.background = '#E8F9EF';
        btn.style.borderColor = '#4CAF7D';
        btn.style.color = '#2B6E4F';
      }
    });

    const input = document.querySelector('.input-field');
    if (input) {
      input.disabled = true;
      input.style.background = '#E8F9EF';
      input.style.borderColor = '#4CAF7D';
    }

    feedback.className = 'feedback show success';
    feedback.innerHTML = '✓ 正確' +
      (q.explanation ? '<span class="explanation">' + escapeHtml(String(q.explanation)) + '</span>' : '');

    const submitBtn = document.getElementById('submitBtn');
    submitBtn.textContent = currentQuestion === shuffledQuestions.length - 1 ? '查看結果' : '下一題';
    submitBtn.onclick = nextQuestion;
  } else {
    log.wrongAttempts.push(displayAnswer(selectedAnswer));

    const selectedBtn = document.querySelector('.option-btn[data-selected="true"]');
    if (selectedBtn) {
      selectedBtn.disabled = true;
      selectedBtn.removeAttribute('data-selected');
      selectedBtn.style.background = '#FDE8E8';
      selectedBtn.style.borderColor = '#E24B4A';
      selectedBtn.style.color = '#8B2323';
    }

    const input = document.querySelector('.input-field');
    if (input) {
      input.value = '';
      input.focus();
    }

    selectedAnswer = null;
    feedback.className = 'feedback show error';
    feedback.textContent = '✗ 錯誤，再試一次';
  }
}

function nextQuestion() {
  currentQuestion++;
  if (currentQuestion >= shuffledQuestions.length) showResults();
  else showQuestion();
}

function startTimer() {
  startTime = Date.now();
  timerInterval = setInterval(() => {
    const elapsed = Math.floor((Date.now() - startTime) / 1000);
    const mins = Math.floor(elapsed / 60);
    const secs = elapsed % 60;
    document.getElementById('timer').textContent =
      mins + ':' + (secs < 10 ? '0' : '') + secs;
  }, 100);
}

function showResults() {
  clearInterval(timerInterval);

  const accuracy = Math.round((correctCount / shuffledQuestions.length) * 100);
  document.getElementById('accuracy').textContent = accuracy + '%';
  document.getElementById('finalCorrect').textContent =
    correctCount + '/' + shuffledQuestions.length;

  const elapsed = Math.floor((Date.now() - startTime) / 1000);
  const mins = Math.floor(elapsed / 60);
  const secs = elapsed % 60;
  document.getElementById('finalTime').textContent =
    mins + ':' + (secs < 10 ? '0' : '') + secs;

  const details = document.getElementById('resultDetails');
  details.innerHTML = '';
  reviewLog.forEach((log, i) => {
    const row = document.createElement('div');
    row.className = 'result-item ' +
      (log.wrongAttempts.length === 0 ? 'correct' : 'incorrect');
    row.textContent = (i + 1) + '. ' +
      (log.wrongAttempts.length === 0 ? '✓ 第一次答對' : '✗ 曾答錯 ' + log.wrongAttempts.length + ' 次');
    details.appendChild(row);
  });

  document.getElementById('resultOverlay').classList.add('show');

  let reviewBtn = document.getElementById('reviewBtn');
  if (!reviewBtn) {
    reviewBtn = document.createElement('button');
    reviewBtn.id = 'reviewBtn';
    reviewBtn.className = 'result-button';
    reviewBtn.style.marginBottom = '10px';
    reviewBtn.textContent = '查看答題複習';
    reviewBtn.onclick = showReview;
    const restart = document.querySelector('#resultOverlay .result-button');
    restart.parentNode.insertBefore(reviewBtn, restart);
  }
}

function showReview() {
  document.getElementById('resultOverlay').classList.remove('show');
  document.querySelector('.stats').style.display = 'none';
  document.getElementById('questionContainer').style.display = 'none';
  document.querySelector('.button-group').style.display = 'none';

  const reviewContainer = document.getElementById('reviewContainer');
  const reviewList = document.getElementById('reviewList');
  reviewList.innerHTML = '';

  reviewLog.forEach((log, i) => {
    const q = shuffledQuestions[i];
    const card = document.createElement('div');
    card.className = 'review-card ' +
      (log.wrongAttempts.length === 0 ? 'first-correct' : 'had-wrong');

    let inner = '<div class="review-q">' + (i + 1) + '. ' +
      escapeHtml(log.question) + '</div>';

    // 題型標示
    inner += '<div class="review-line">題型：' + escapeHtml(typeNames[log.type]) + '</div>';

    // 選擇題：把所有選項一起列出，並標記正確答案與曾答錯選項
    if (log.type === 3 && q.options) {
      inner += '<div class="review-line">選項：</div>';
      q.options.forEach(opt => {
        const isCorrect = normalize(opt) === normalize(q.answer);
        const wasWrong = log.wrongAttempts.some(w => normalize(w) === normalize(opt));

        let mark = '';
        let cls = '';
        if (isCorrect) {
          mark = '✓ ';
          cls = ' review-correct';
        } else if (wasWrong) {
          mark = '✗ ';
          cls = ' review-wrong';
        }

        inner += '<div class="review-line' + cls + '">' +
          mark + escapeHtml(String(opt)) + '</div>';
      });
    }

    // 是非題：顯示 O / X
    if (log.type === 9) {
      inner += '<div class="review-line review-correct">正確答案：' +
        escapeHtml(displayAnswer(q.answer)) + '</div>';
    }

    // 填空題：顯示標準答案
    if (log.type === 4) {
      inner += '<div class="review-line review-correct">正確答案：' +
        escapeHtml(String(q.answer)) + '</div>';
    }

    // 自動選擇題：顯示標準答案
    if (log.type === 2) {
      inner += '<div class="review-line review-correct">正確答案：' +
        escapeHtml(String(q.answer)) + '</div>';
    }

    if (log.wrongAttempts.length === 0) {
      inner += '<div class="review-line review-correct">✓ 第一次答對</div>';
    } else {
      inner += '<div class="review-line review-wrong">答錯過：' +
        log.wrongAttempts.map(escapeHtml).join('、') + '</div>';
    }

    if (log.explanation) {
      inner += '<div class="review-line">解析：' +
        escapeHtml(String(log.explanation)) + '</div>';
    }

    card.innerHTML = inner;
    reviewList.appendChild(card);
  });

  reviewContainer.classList.add('show');
}

function escapeHtml(value) {
  return String(value)
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#039;');
}

initGame();

</script>
